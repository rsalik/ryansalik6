{
  "name": "ryan-salik-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "preview:cloudflare": "wrangler pages dev .svelte-kit/cloudflare",
    "deploy": "sh scripts/deploy.sh",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "format": "prettier --write src tests *.config.* package.json tsconfig.json .prettierrc.json",
    "format:check": "prettier --check src tests *.config.* package.json tsconfig.json .prettierrc.json"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "@ryansalik/photo-api": "file:../photo_api"
  },
  "devDependencies": {
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/kit": "^2.37.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.0",
    "prettier": "^3.9.8",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.39.0",
    "svelte-check": "^4.3.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "wrangler": "^4.135.0"
  }
}
