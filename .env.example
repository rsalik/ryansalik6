# Server-only values. Never prefix photography secrets with PUBLIC_.
# Use the shared HTTP service when deployed; otherwise the shared repository
# reads the current Neon database directly from the SvelteKit server.
# PHOTO_API_URL=https://photo-api.example.workers.dev
# PHOTO_DATABASE_URL=postgresql://read_only_user:password@host/database?sslmode=require
PHOTO_IMAGE_BASE_URL=https://cdn.photos.ryansalik.com
